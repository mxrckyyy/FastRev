# FastRev environment variables — copy to `.env` and fill in real values.
# `.env` is gitignored; NEVER commit real values or paste them into docs/code.
#
# Both values are CLIENT-SAFE by design: they identify your Supabase project
# and carry the public anon key. They ship in the browser bundle on purpose —
# Row Level Security (supabase/schema.sql) is what protects the data.
# Never put a service_role key, database password or JWT secret in this file.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
